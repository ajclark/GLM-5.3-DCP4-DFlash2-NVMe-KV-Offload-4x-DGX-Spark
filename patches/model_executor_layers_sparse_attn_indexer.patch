+# The logits width and strides vary per batch (prefill: this rank's local
+# context; decode: the static width), and Triton specializes integer args on
+# divisibility by 16 and equality to 1 by default. Every new specialization is
+# a JIT *during inference*, which on the memory-starved Sparks has killed a
+# worker and wedged the TP ring (INCIDENT-20260904-0229). Compile once.
+@triton.jit(do_not_specialize=["logits_stride0", "logits_stride1", "num_cols"])
+def _pack_dcp_topk_candidates_kernel(
+    logits,           # f32 [rows, cols]  this rank's local logits
+    topk_indices,     # i32 [rows, TOPK]  this rank's LOCAL top-k positions
+    packed,           # f32 [rows, TOPK, 2] -> (score, global_id)
+    row_starts,       # i32 [rows] or aliased dummy
+    logits_stride0,
+    logits_stride1,
+    topk_stride0,
+    topk_stride1,
+    packed_stride0,
+    packed_stride1,
+    packed_stride2,
+    num_cols,
+    DCP_RANK: tl.constexpr,
+    DCP_WORLD_SIZE: tl.constexpr,
+    CP_INTERLEAVE: tl.constexpr,
+    HAS_ROW_STARTS: tl.constexpr,
+    TOPK: tl.constexpr,
+    BLOCK_SIZE: tl.constexpr,
+):
+    """Pair each local top-k position with its score and its GLOBAL position.
+
+    Inverse of the DCP slot mapping: a local position l on rank r corresponds
+    to global position (l // I) * (N * I) + r * I + l % I.
+    """
+    row = tl.program_id(0)
+    tile = tl.program_id(1)
+    cols = tile * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)
+    mask = cols < TOPK
+
+    local_idx = tl.load(
+        topk_indices + row * topk_stride0 + cols * topk_stride1, mask=mask, other=-1
+    )
+    valid = local_idx >= 0
+    safe_local_idx = tl.maximum(local_idx, 0)
+
+    row_start = 0
+    if HAS_ROW_STARTS:
+        row_start = tl.load(row_starts + row)
+
+    # Clamp so an invalid lane never reads out of bounds; it is masked anyway.
+    score_col = safe_local_idx + row_start
+    score_col = tl.minimum(score_col, tl.maximum(num_cols - 1, 0))
+    score = tl.load(
+        logits + row * logits_stride0 + score_col * logits_stride1,
+        mask=mask & valid,
+        other=-float("inf"),
+    )
+    # A -inf score would collide with the padding sentinel after the merge;
+    # invalid lanes already carry -inf, so nothing else needs to.
+    score = tl.where(valid, score, -float("inf"))
+
+    global_id = (
+        (safe_local_idx // CP_INTERLEAVE) * (DCP_WORLD_SIZE * CP_INTERLEAVE)
+        + DCP_RANK * CP_INTERLEAVE
+        + safe_local_idx % CP_INTERLEAVE
+    )
+    global_id = tl.where(valid, global_id, -1)
+
+    packed_base = packed + row * packed_stride0 + cols * packed_stride1
+    tl.store(packed_base, score, mask=mask)
+    tl.store(packed_base + packed_stride2, global_id.to(tl.float32), mask=mask)
+
+
+def _merge_dcp_topk_global(
+    logits: torch.Tensor | None,
+    topk_indices: torch.Tensor,
+    topk_tokens: int,
+    dcp_rank: int,
+    dcp_world_size: int,
+    cp_interleave: int,
+    row_starts: torch.Tensor | None = None,
+) -> None:
+    """Merge each DCP rank's local top-k into the global top-k, in place.
+
+    ``topk_indices`` holds this rank's top-k positions into its 1/N shard of
+    the context. A token in the global top-K must also be in its owning rank's
+    local top-K (at most K-1 tokens outrank it globally, hence at most K-1 on
+    its own rank), so exchanging only the per-rank candidates is *exact*:
+    equivalent to all-gathering the whole logit row, but shipping
+    ``N * K`` candidates instead of the whole context.
+
+    On return ``topk_indices`` holds GLOBAL positions (-1 for padding); the
+    attention backend maps them back to physical slots per rank.
+
+    Every rank runs identical arithmetic on the identical gathered tensor, so
+    all ranks agree on the selected set -- which they must, or a selected
+    token whose owner did not select it would silently drop out of the merge.
+    """
+    if dcp_world_size <= 1:
+        return
+
+    rows, k = topk_indices.shape
+    device = topk_indices.device
+    assert topk_indices.dtype == torch.int32
+    assert k == topk_tokens, (k, topk_tokens)
+
+    if logits is None or logits.numel() == 0:
+        # This rank owns nothing in this chunk; it still has to take part in
+        # the all-gather so the collective count matches the other ranks.
+        logits = torch.full((rows, 1), float("-inf"), dtype=torch.float32, device=device)
+        topk_indices.fill_(-1)
+
+    packed = torch.empty((rows, k, 2), dtype=torch.float32, device=device)
+    block = 512
+    grid = (rows, cdiv(k, block))
+    _pack_dcp_topk_candidates_kernel[grid](
+        logits,
+        topk_indices,
+        packed,
+        row_starts if row_starts is not None else topk_indices,
+        logits.stride(0),
+        logits.stride(1),
+        topk_indices.stride(0),
+        topk_indices.stride(1),
+        packed.stride(0),
+        packed.stride(1),
+        packed.stride(2),
+        logits.shape[1],
+        DCP_RANK=dcp_rank,
+        DCP_WORLD_SIZE=dcp_world_size,
+        CP_INTERLEAVE=cp_interleave,
+        HAS_ROW_STARTS=row_starts is not None,
+        TOPK=k,
+        BLOCK_SIZE=block,
+        num_warps=8,
+    )
+
+    # [rows, N * K, 2]
+    gathered = get_dcp_group().all_gather(packed, dim=1)
+    scores = gathered[..., 0]
+    ids = gathered[..., 1]
+    best_scores, sel = torch.topk(scores, topk_tokens, dim=1)
+    merged = torch.gather(ids, 1, sel).to(torch.int32)
+    # Candidates that were padding (or genuinely -inf) stay padding.
+    merged = torch.where(
+        best_scores > float("-inf"), merged, torch.full_like(merged, -1)
+    )
+    topk_indices.copy_(merged)
+
