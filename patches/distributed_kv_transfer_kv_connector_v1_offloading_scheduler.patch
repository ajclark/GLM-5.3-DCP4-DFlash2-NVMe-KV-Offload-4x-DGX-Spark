+def storable_blocks(group_config: GroupOffloadConfig, num_tokens: int) -> int:
+    """Blocks of a group that may be stored once `num_tokens` are computed.
+
+    DCP overlay: eagle trailing block is revisited next step. The trailing
+    block of an eagle group is volatile, so it is held back here; the store
+    progress index must be advanced to this same value (not to the raw block
+    count) so the held-back block is stored on the next step, once it is no
+    longer trailing. Advancing past it left one unstored block per prefill
+    step in every group (DFlash marks every group as eagle), which a later
+    request with the whole prompt in one step silently refilled, but which
+    broke every prefix lookup at the first hole after a restart.
+    """
+    num_blocks = num_tokens // group_config.offloaded_block_size
+    if group_config.is_eagle_group:
+        num_blocks = max(0, num_blocks - 1)
+    return num_blocks
+
